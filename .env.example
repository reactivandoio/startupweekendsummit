# Copie para .env (não versionado). O docker compose lê este arquivo nos dois perfis.

# Postgres (container "db" em prod, "db-dev" em dev)
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# URL pública, usada nos links de acesso enviados por e-mail
APP_URL=https://startupweekendsummit.com.br

# Primeiro usuário do painel (/admin). Criado na primeira conexão ao banco; os demais são adicionados pelo painel.
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=

# SMTP para os links de acesso (Mailgun). Sem SMTP_HOST, o e-mail é apenas logado no console.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TSW Summit Brasil <contato@8020digital.com.br>

# Inscrições pagas (Stripe). Sem STRIPE_SECRET_KEY ou TICKET_PRICE_CENTS a página do convite mostra "em breve".
# Chave secreta (sk_live_… ou sk_test_…) em Developers → API keys
STRIPE_SECRET_KEY=
# Signing secret (whsec_…) do endpoint https://startupweekendsummit.com.br/api/stripe/webhook
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=
# Valor único do ingresso, em centavos (ex.: 35000 = R$ 350,00)
TICKET_PRICE_CENTS=
