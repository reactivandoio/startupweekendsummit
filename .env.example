# Copie para .env (não versionado). O docker compose lê este arquivo nos dois perfis.

# Postgres (container "db" em prod, "db-dev" em dev)
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# URL pública, usada nos links de acesso enviados por e-mail
APP_URL=https://startupweekendsummit.com.br

# Primeiro usuário do painel (/admin). Criado na primeira conexão ao banco; os demais são adicionados pelo painel.
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=

# SMTP para os links de acesso (Mailgun). Sem SMTP_HOST, o e-mail é apenas logado no console.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TSW Summit Brasil <contato@8020digital.com.br>
